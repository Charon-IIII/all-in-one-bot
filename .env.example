DISCORD_TOKEN=replace-with-your-bot-token
DEEPL_API_KEY=replace-with-your-deepl-api-key
DATABASE_PATH=data/community_bot.sqlite3
# Optional: sync slash commands to one development server for instant updates.
SYNC_GUILD_ID=
LOG_LEVEL=INFO
# Turn on for the .tr translator, text-based automod, or full message text in logs.
# Also enable Message Content Intent in the Discord Developer Portal.
MESSAGE_CONTENT_INTENT=false
